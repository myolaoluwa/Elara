DATABASE_URL="file:./dev.db"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
# Text generation: offline, openai, openrouter, gemini, cerebras, xai, or deepseek.
# Only the selected provider's key is required. "grok" is accepted as an alias for "xai".
# Keep these server-side: never prefix secret values with NEXT_PUBLIC_.
AI_PROVIDER="offline"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
CEREBRAS_API_KEY=""
CEREBRAS_MODEL="gpt-oss-120b"
XAI_API_KEY=""
XAI_MODEL="grok-4"
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
