DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/elara?sslmode=require"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"

# Transactional email through Brevo's HTTPS API.
# Create an API v3 key and verify the sender email/domain in Brevo first.
EMAIL_PROVIDER="brevo"
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="verified-sender@example.com"
BREVO_SENDER_NAME="Elara"
BREVO_REPLY_TO_EMAIL=""
# Optional Brevo template IDs for future auth and invitation messages.
BREVO_EMAIL_VERIFICATION_TEMPLATE_ID=""
BREVO_PASSWORD_RESET_TEMPLATE_ID=""
BREVO_INVITATION_TEMPLATE_ID=""

# Gmail delegation. Create a Google OAuth web client, enable Gmail API, and add:
# https://your-domain.example/api/email/connect/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Generate both secrets independently with: openssl rand -base64 32
EMAIL_TOKEN_ENCRYPTION_KEY=""
JOB_SECRET=""
# Used by the Railway scheduled-email cron service. Defaults to BETTER_AUTH_URL.
APP_URL="http://localhost:3000"

# Text generation: offline, openai, openrouter, gemini, cerebras, xai, or deepseek.
# Only the selected provider's key is required. "grok" is accepted as an alias for "xai".
# Keep these server-side: never prefix secret values with NEXT_PUBLIC_.
AI_PROVIDER="offline"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
CEREBRAS_API_KEY=""
CEREBRAS_MODEL="gpt-oss-120b"
XAI_API_KEY=""
XAI_MODEL="grok-4"
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
