generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  EA
  EXECUTIVE
  MEMBER
  VIEWER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum FollowUpStatus {
  OPEN
  SNOOZED
  RESOLVED
  CANCELLED
}

enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum ActionPermission {
  READ
  SUGGEST
  EXECUTE
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum ReminderStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum MeetingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DocumentStatus {
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum MailboxProvider {
  GMAIL
}

enum MailboxStatus {
  ACTIVE
  REAUTH_REQUIRED
  DISCONNECTED
}

enum OutboundEmailStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum ResearchStatus {
  DRAFT
  COMPLETE
  FAILED
  ARCHIVED
}

enum BriefingType {
  DAILY
  MEETING
  TRAVEL
  WEEKLY
  CUSTOM
}

enum TravelStatus {
  DRAFT
  CONFIRMED
  ACTIVE
  COMPLETE
  CANCELLED
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  REIMBURSED
}

enum InvoiceStatus {
  DRAFT
  DUE
  PAID
  OVERDUE
  CANCELLED
}

enum EventPlanStatus {
  DRAFT
  PLANNING
  CONFIRMED
  COMPLETE
  CANCELLED
}

enum AutomationRunStatus {
  PENDING
  WAITING_APPROVAL
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  emailVerified      Boolean             @default(false)
  name               String
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  twoFactorEnabled   Boolean             @default(false)
  memberships        Membership[]
  profile            UserProfile?
  taskOwners         Task[]              @relation("TaskOwner")
  activities         ActivityLog[]
  approvals          AIAction[]          @relation("ActionApprover")
  sessions           Session[]
  accounts           Account[]
  twoFactors         TwoFactor[]
  mailboxConnections MailboxConnection[]
  outboundEmails     OutboundEmail[]     @relation("OutboundEmailCreator")
  oauthStates        OAuthState[]
  pushSubscriptions  PushSubscription[]
  reminders          Reminder[]
}

model TwoFactor {
  id                      String    @id @default(cuid())
  userId                  String
  secret                  String
  backupCodes             String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model UserProfile {
  id       String  @id @default(cuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobTitle String?
  timezone String  @default("UTC")
  locale   String  @default("en")
}

model Organization {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  memberships        Membership[]
  executives         Executive[]
  contacts           Contact[]
  companies          Company[]
  projects           Project[]
  tasks              Task[]
  meetings           Meeting[]
  calendarEvents     CalendarEvent[]
  documents          Document[]
  emails             Email[]
  followUps          FollowUp[]
  decisions          Decision[]
  commitments        Commitment[]
  conversations      AIConversation[]
  aiActions          AIAction[]
  notifications      Notification[]
  automations        Automation[]
  activityLogs       ActivityLog[]
  contactGroups      ContactGroup[]
  mailboxConnections MailboxConnection[]
  outboundEmails     OutboundEmail[]
  oauthStates        OAuthState[]
  memoryItems        MemoryItem[]
  documentFolders    DocumentFolder[]
  researchReports    ResearchReport[]
  briefings          Briefing[]
  travelPlans        TravelPlan[]
  expenseReports     ExpenseReport[]
  expenses           Expense[]
  invoices           Invoice[]
  vendors            Vendor[]
  eventPlans         EventPlan[]
  pushSubscriptions  PushSubscription[]
  reminders          Reminder[]
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now())
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model Executive {
  id             String                @id @default(cuid())
  organizationId String
  name           String
  email          String?
  title          String?
  timezone       String                @default("UTC")
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  preferences    ExecutivePreference[]
  meetings       Meeting[]
  calendarEvents CalendarEvent[]
  TravelPlan     TravelPlan[]

  @@index([organizationId])
}

model ExecutivePreference {
  id          String    @id @default(cuid())
  executiveId String
  category    String
  key         String
  valueJson   String
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  executive   Executive @relation(fields: [executiveId], references: [id], onDelete: Cascade)

  @@unique([executiveId, category, key])
}

model Company {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  website        String?
  notes          String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts       Contact[]
  projects       Project[]

  @@index([organizationId, name])
}

model Contact {
  id               String               @id @default(cuid())
  organizationId   String
  companyId        String?
  name             String
  email            String?
  phone            String?
  role             String?
  relationship     String?
  notes            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company          Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  meetingLinks     MeetingAttendee[]
  tasks            Task[]
  emails           Email[]
  followUps        FollowUp[]
  commitments      Commitment[]
  groupMemberships ContactGroupMember[]
  outboundEmails   OutboundEmail[]

  @@index([organizationId, name])
  @@index([organizationId, email])
}

model ContactGroup {
  id             String               @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        ContactGroupMember[]
  outboundEmails OutboundEmail[]

  @@unique([organizationId, name])
  @@index([organizationId, updatedAt])
}

model ContactGroupMember {
  id        String       @id @default(cuid())
  groupId   String
  contactId String
  createdAt DateTime     @default(now())
  group     ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([groupId, contactId])
  @@index([contactId])
}

model MailboxConnection {
  id                    String          @id @default(cuid())
  organizationId        String
  userId                String
  provider              MailboxProvider
  emailAddress          String
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  accessTokenExpiresAt  DateTime?
  scopesJson            String          @default("[]")
  status                MailboxStatus   @default(ACTIVE)
  historyId             String?
  lastSyncedAt          DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  outboundEmails        OutboundEmail[]

  @@unique([organizationId, userId, provider])
  @@index([organizationId, status])
}

model OAuthState {
  id                    String          @id @default(cuid())
  stateHash             String          @unique
  organizationId        String
  userId                String
  provider              MailboxProvider
  codeVerifierEncrypted String
  expiresAt             DateTime
  createdAt             DateTime        @default(now())
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([organizationId, userId])
}

model OutboundEmail {
  id                  String              @id @default(cuid())
  organizationId      String
  mailboxConnectionId String?
  createdById         String
  contactId           String?
  groupId             String?
  toEmail             String
  toName              String
  fromName            String
  subject             String
  bodyText            String
  status              OutboundEmailStatus @default(DRAFT)
  scheduledAt         DateTime?
  sentAt              DateTime?
  externalId          String?
  providerDraftId     String?
  threadId            String?
  lastError           String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mailboxConnection   MailboxConnection?  @relation(fields: [mailboxConnectionId], references: [id], onDelete: SetNull)
  createdBy           User                @relation("OutboundEmailCreator", fields: [createdById], references: [id], onDelete: Cascade)
  contact             Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  group               ContactGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, scheduledAt])
  @@index([mailboxConnectionId, status])
  @@index([createdById, createdAt])
}

model Project {
  id             String       @id @default(cuid())
  organizationId String
  companyId      String?
  name           String
  description    String?
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  tasks          Task[]
  meetings       Meeting[]
  documents      Document[]
  decisions      Decision[]
  commitments    Commitment[]

  @@index([organizationId, status])
}

model Task {
  id             String           @id @default(cuid())
  organizationId String
  projectId      String?
  ownerId        String?
  contactId      String?
  title          String
  notes          String?
  status         TaskStatus       @default(TODO)
  priority       Priority         @default(NORMAL)
  dueAt          DateTime?
  sourceType     String?
  sourceId       String?
  tagsJson       String           @default("[]")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  completedAt    DateTime?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  owner          User?            @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contact        Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  followUps      FollowUp[]
  attachments    TaskAttachment[]

  @@index([organizationId, status, dueAt])
  @@index([organizationId, ownerId])
}

model TaskAttachment {
  id         String   @id @default(cuid())
  taskId     String
  documentId String
  createdAt  DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([taskId, documentId])
  @@index([documentId])
}

model Meeting {
  id             String            @id @default(cuid())
  organizationId String
  executiveId    String?
  projectId      String?
  title          String
  status         MeetingStatus     @default(SCHEDULED)
  startsAt       DateTime
  endsAt         DateTime
  location       String?
  meetingUrl     String?
  agenda         String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executive      Executive?        @relation(fields: [executiveId], references: [id], onDelete: SetNull)
  project        Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  attendees      MeetingAttendee[]
  notes          MeetingNote[]
  transcriptions Transcription[]
  calendarEvent  CalendarEvent?
  decisions      Decision[]
  commitments    Commitment[]

  @@index([organizationId, startsAt])
}

model MeetingAttendee {
  id        String   @id @default(cuid())
  meetingId String
  contactId String?
  name      String
  email     String?
  response  String?
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([meetingId])
}

model MeetingNote {
  id        String   @id @default(cuid())
  meetingId String
  kind      String   @default("note")
  content   String
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, kind])
}

model Transcription {
  id           String   @id @default(cuid())
  meetingId    String
  provider     String?
  status       String   @default("pending")
  text         String?
  segmentsJson String?
  createdAt    DateTime @default(now())
  meeting      Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model CalendarEvent {
  id             String       @id @default(cuid())
  organizationId String
  executiveId    String?
  meetingId      String?      @unique
  externalId     String?
  provider       String?
  title          String
  startsAt       DateTime
  endsAt         DateTime
  timezone       String
  location       String?
  recurrenceJson String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executive      Executive?   @relation(fields: [executiveId], references: [id], onDelete: SetNull)
  meeting        Meeting?     @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@unique([organizationId, provider, externalId])
  @@index([organizationId, startsAt])
}

model Document {
  id              String           @id @default(cuid())
  organizationId  String
  projectId       String?
  name            String
  mimeType        String
  storageKey      String
  sizeBytes       Int
  status          DocumentStatus   @default(PROCESSING)
  extractedText   String?
  tagsJson        String           @default("[]")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  folderId        String?
  parentId        String?
  versionNumber   Int              @default(1)
  summary         String?
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  folder          DocumentFolder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  parent          Document?        @relation("DocumentVersions", fields: [parentId], references: [id], onDelete: SetNull)
  versions        Document[]       @relation("DocumentVersions")
  taskAttachments TaskAttachment[]
  travelDocuments TravelDocument[]
  expenseReceipts Expense[]        @relation("ExpenseReceipt")
  vendorContracts VendorContract[]

  @@index([organizationId, status])
  @@index([organizationId, folderId])
  @@index([parentId, versionNumber])
}

model DocumentFolder {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  parentId       String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         DocumentFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       DocumentFolder[] @relation("FolderTree")
  documents      Document[]

  @@unique([organizationId, parentId, name])
  @@index([organizationId, name])
}

model Email {
  id             String       @id @default(cuid())
  organizationId String
  contactId      String?
  provider       String
  externalId     String
  threadId       String?
  subject        String
  sender         String
  recipientsJson String
  bodyText       String?
  receivedAt     DateTime
  isImportant    Boolean      @default(false)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([organizationId, provider, externalId])
  @@index([organizationId, receivedAt])
}

model FollowUp {
  id             String         @id @default(cuid())
  organizationId String
  taskId         String?
  contactId      String?
  title          String
  notes          String?
  status         FollowUpStatus @default(OPEN)
  dueAt          DateTime?
  lastContactAt  DateTime?
  sourceType     String?
  sourceId       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task           Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  contact        Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, dueAt])
}

model Decision {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String?
  meetingId      String?
  title          String
  rationale      String?
  decidedAt      DateTime
  confirmed      Boolean      @default(false)
  sourceType     String?
  sourceId       String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  meeting        Meeting?     @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([organizationId, decidedAt])
}

model Commitment {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String?
  meetingId      String?
  contactId      String?
  description    String
  dueAt          DateTime?
  status         String       @default("open")
  confirmed      Boolean      @default(false)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  meeting        Meeting?     @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, dueAt])
}

model AIConversation {
  id             String       @id @default(cuid())
  organizationId String
  title          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       AIMessage[]
  actions        AIAction[]

  @@index([organizationId, updatedAt])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String
  content        String
  citationsJson  String?
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AIAction {
  id             String           @id @default(cuid())
  organizationId String
  conversationId String?
  approverId     String?
  toolName       String
  permission     ActionPermission
  inputJson      String
  resultJson     String?
  approvalStatus ApprovalStatus   @default(NOT_REQUIRED)
  createdAt      DateTime         @default(now())
  executedAt     DateTime?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation   AIConversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  approver       User?            @relation("ActionApprover", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([approvalStatus])
}

model Notification {
  id             String             @id @default(cuid())
  organizationId String
  title          String
  body           String
  priority       Priority           @default(NORMAL)
  status         NotificationStatus @default(UNREAD)
  sourceType     String?
  sourceId       String?
  createdAt      DateTime           @default(now())
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, createdAt])
}

model PushSubscription {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  endpoint       String       @unique
  p256dh         String
  auth           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
}

model Reminder {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  title          String
  body           String         @default("")
  triggerAt      DateTime
  status         ReminderStatus @default(PENDING)
  claimedAt      DateTime?
  attempts       Int            @default(0)
  sentAt         DateTime?
  lastError      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, triggerAt])
  @@index([organizationId, userId, status, triggerAt])
}

model Automation {
  id               String           @id @default(cuid())
  organizationId   String
  name             String
  description      String?
  status           AutomationStatus @default(DRAFT)
  triggerJson      String
  conditionsJson   String           @default("[]")
  actionsJson      String
  requiresApproval Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs             AutomationRun[]

  @@index([organizationId, status])
}

model AutomationRun {
  id              String              @id @default(cuid())
  automationId    String
  status          AutomationRunStatus @default(PENDING)
  triggerDataJson String              @default("{}")
  stepsJson       String              @default("[]")
  resultJson      String?
  error           String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime            @default(now())
  automation      Automation          @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId, status, createdAt])
}

model MemoryItem {
  id             String       @id @default(cuid())
  organizationId String
  category       String
  title          String
  content        String
  sourceType     String?
  sourceId       String?
  confirmed      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, category, confirmed])
  @@index([organizationId, updatedAt])
}

model ResearchReport {
  id             String         @id @default(cuid())
  organizationId String
  topic          String
  subjectType    String
  question       String?
  summary        String?
  findingsJson   String         @default("[]")
  sourcesJson    String         @default("[]")
  status         ResearchStatus @default(DRAFT)
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, updatedAt])
}

model Briefing {
  id             String       @id @default(cuid())
  organizationId String
  type           BriefingType
  title          String
  periodStart    DateTime?
  periodEnd      DateTime?
  contentJson    String
  sourceIdsJson  String       @default("[]")
  confirmed      Boolean      @default(false)
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type, createdAt])
}

model TravelPlan {
  id             String                @id @default(cuid())
  organizationId String
  executiveId    String?
  title          String
  destination    String
  startsAt       DateTime
  endsAt         DateTime
  timezone       String
  status         TravelStatus          @default(DRAFT)
  purpose        String?
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executive      Executive?            @relation(fields: [executiveId], references: [id], onDelete: SetNull)
  flights        Flight[]
  hotels         HotelStay[]
  transports     GroundTransport[]
  documents      TravelDocument[]
  itinerary      TravelItineraryItem[]
  reminders      TravelReminder[]
  events         EventPlan[]

  @@index([organizationId, startsAt])
  @@index([organizationId, status])
}

model TravelItineraryItem {
  id           String     @id @default(cuid())
  travelPlanId String
  title        String
  kind         String     @default("meeting")
  startsAt     DateTime
  endsAt       DateTime?
  location     String?
  notes        String?
  travelPlan   TravelPlan @relation(fields: [travelPlanId], references: [id], onDelete: Cascade)

  @@index([travelPlanId, startsAt])
}

model TravelReminder {
  id           String     @id @default(cuid())
  travelPlanId String
  title        String
  remindAt     DateTime
  completed    Boolean    @default(false)
  travelPlan   TravelPlan @relation(fields: [travelPlanId], references: [id], onDelete: Cascade)

  @@index([travelPlanId, remindAt])
}

model Flight {
  id               String     @id @default(cuid())
  travelPlanId     String
  airline          String
  flightNumber     String
  departureAirport String
  arrivalAirport   String
  departsAt        DateTime
  arrivesAt        DateTime
  confirmationCode String?
  cabin            String?
  notes            String?
  travelPlan       TravelPlan @relation(fields: [travelPlanId], references: [id], onDelete: Cascade)

  @@index([travelPlanId, departsAt])
}

model HotelStay {
  id               String     @id @default(cuid())
  travelPlanId     String
  hotelName        String
  address          String?
  checksInAt       DateTime
  checksOutAt      DateTime
  confirmationCode String?
  phone            String?
  notes            String?
  travelPlan       TravelPlan @relation(fields: [travelPlanId], references: [id], onDelete: Cascade)

  @@index([travelPlanId, checksInAt])
}

model GroundTransport {
  id               String     @id @default(cuid())
  travelPlanId     String
  type             String
  provider         String?
  pickupAt         DateTime
  pickupLocation   String
  dropoffLocation  String?
  confirmationCode String?
  notes            String?
  travelPlan       TravelPlan @relation(fields: [travelPlanId], references: [id], onDelete: Cascade)

  @@index([travelPlanId, pickupAt])
}

model TravelDocument {
  id           String     @id @default(cuid())
  travelPlanId String
  documentId   String
  kind         String
  expiresAt    DateTime?
  travelPlan   TravelPlan @relation(fields: [travelPlanId], references: [id], onDelete: Cascade)
  document     Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([travelPlanId, documentId])
}

model ExpenseReport {
  id             String        @id @default(cuid())
  organizationId String
  title          String
  periodStart    DateTime?
  periodEnd      DateTime?
  currency       String        @default("USD")
  status         ExpenseStatus @default(DRAFT)
  submittedAt    DateTime?
  approvedAt     DateTime?
  reimbursedAt   DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses       Expense[]

  @@index([organizationId, status, createdAt])
}

model Expense {
  id             String         @id @default(cuid())
  organizationId String
  reportId       String?
  vendorId       String?
  receiptId      String?
  description    String
  category       String
  amountMinor    Int
  currency       String         @default("USD")
  incurredAt     DateTime
  status         ExpenseStatus  @default(DRAFT)
  reimbursable   Boolean        @default(true)
  extractedJson  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  report         ExpenseReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  vendor         Vendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  receipt        Document?      @relation("ExpenseReceipt", fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, incurredAt])
  @@index([reportId])
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  vendorId       String?
  invoiceNumber  String
  description    String?
  amountMinor    Int
  currency       String        @default("USD")
  issuedAt       DateTime?
  dueAt          DateTime?
  paidAt         DateTime?
  status         InvoiceStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor         Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status, dueAt])
}

model Vendor {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  category       String?
  email          String?
  phone          String?
  website        String?
  status         String           @default("active")
  renewalAt      DateTime?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts       VendorContact[]
  quotes         VendorQuote[]
  contracts      VendorContract[]
  payments       VendorPayment[]
  expenses       Expense[]
  invoices       Invoice[]
  events         EventVendor[]

  @@unique([organizationId, name])
  @@index([organizationId, status, renewalAt])
}

model VendorContact {
  id       String  @id @default(cuid())
  vendorId String
  name     String
  email    String?
  phone    String?
  role     String?
  vendor   Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model VendorQuote {
  id          String    @id @default(cuid())
  vendorId    String
  title       String
  amountMinor Int?
  currency    String    @default("USD")
  validUntil  DateTime?
  status      String    @default("received")
  notes       String?
  createdAt   DateTime  @default(now())
  vendor      Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, status])
}

model VendorContract {
  id         String    @id @default(cuid())
  vendorId   String
  documentId String?
  title      String
  startsAt   DateTime?
  endsAt     DateTime?
  renewalAt  DateTime?
  status     String    @default("active")
  notes      String?
  vendor     Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([vendorId, renewalAt])
}

model VendorPayment {
  id          String    @id @default(cuid())
  vendorId    String
  description String
  amountMinor Int
  currency    String    @default("USD")
  dueAt       DateTime?
  paidAt      DateTime?
  status      String    @default("due")
  createdAt   DateTime  @default(now())
  vendor      Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, status, dueAt])
}

model EventPlan {
  id                 String              @id @default(cuid())
  organizationId     String
  title              String
  description        String?
  venue              String?
  startsAt           DateTime
  endsAt             DateTime
  timezone           String
  status             EventPlanStatus     @default(DRAFT)
  budgetMinor        Int?
  currency           String              @default("USD")
  travelPlanId       String?
  cateringNotes      String?
  accommodationNotes String?
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  guests             EventGuest[]
  vendors            EventVendor[]
  schedule           EventScheduleItem[]
  travelPlan         TravelPlan?         @relation(fields: [travelPlanId], references: [id], onDelete: SetNull)

  @@index([organizationId, startsAt])
  @@index([organizationId, status])
  @@index([travelPlanId])
}

model EventGuest {
  id        String    @id @default(cuid())
  eventId   String
  name      String
  email     String?
  rsvp      String    @default("pending")
  plusOnes  Int       @default(0)
  notes     String?
  invitedAt DateTime?
  event     EventPlan @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, rsvp])
}

model EventVendor {
  id          String    @id @default(cuid())
  eventId     String
  vendorId    String
  purpose     String
  status      String    @default("proposed")
  amountMinor Int?
  event       EventPlan @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vendor      Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([eventId, vendorId, purpose])
}

model EventScheduleItem {
  id       String    @id @default(cuid())
  eventId  String
  title    String
  startsAt DateTime
  endsAt   DateTime?
  location String?
  owner    String?
  notes    String?
  event    EventPlan @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, startsAt])
}

model ActivityLog {
  id               String         @id @default(cuid())
  organizationId   String
  actorUserId      String?
  actorType        String
  action           String
  entityType       String?
  entityId         String?
  source           String?
  dataAccessedJson String?
  resultJson       String?
  approvalStatus   ApprovalStatus @default(NOT_REQUIRED)
  createdAt        DateTime       @default(now())
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor            User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}
